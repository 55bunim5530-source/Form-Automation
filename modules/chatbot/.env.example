# OpenAI 키는 서버에서만 사용하며 브라우저에 공개하지 않습니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# 다른 팀의 기능 URL이 준비되면 해당 주소를 입력하고 다시 빌드합니다.
NEXT_PUBLIC_RISK_ASSESSMENT_URL=http://127.0.0.1:8080/shell/app.html?module=inspection
NEXT_PUBLIC_MSDS_URL=http://127.0.0.1:8080/shell/app.html?module=msds
NEXT_PUBLIC_FORMS_URL=http://127.0.0.1:8080/shell/app.html?module=forms
NEXT_PUBLIC_CONTRACTOR_URL=http://127.0.0.1:8080/shell/app.html?module=forms
